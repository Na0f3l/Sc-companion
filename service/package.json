{
  "name": "sc-companion-service",
  "version": "0.1.0",
  "private": true,
  "description": "Service local : récupère la télémétrie de Star Citizen et la diffuse à l'interface par WebSocket",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "live": "node src/index.ts",
    "replay": "node src/index.ts --replay ../telemetrie/captures",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "koffi": "^3.3.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "~5.9.0"
  }
}
