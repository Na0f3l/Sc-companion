# --- Données personnelles : ne jamais publier ---
# Sessions enregistrées (CSV, rapports, incidents, copies du Game.log avec pseudo / infos de compte)
memoire/tracking/
# Réglages locaux (positions de fenêtre, dossier du jeu) et journal d'erreurs
memoire/app/reglages.json
memoire/app/erreurs.log
# Captures de télémétrie (solde aUEC, identifiants de vaisseau…)
telemetrie/captures/

# --- Schéma tiers sans licence (Sokren/sc-telemetry-deck) : à récupérer soi-même, voir README ---
telemetrie/proto/*.proto

# --- Générés ---
# données du service : vaisseaux mis à jour depuis l'interface (la copie publiée est interface/public/data),
# réglages communs (config.json) et sessions de jeu enregistrées (sessions/, personnelles)
service/data/
node_modules/
memoire/partage/

# --- Système / éditeur ---
Thumbs.db
desktop.ini
.vscode/
*.log

# --- Sons d'origine (Mixkit) : seules les versions coupées de interface/public/sounds sont publiées ---
/sounds/
